# Copy this file to .env and fill in your key. Never commit the real .env file.
#
# Get a key at https://console.anthropic.com/settings/keys (a debit card works
# fine for billing — Anthropic just needs a card on file, not a credit line).
#
# IMPORTANT: do NOT rename this to EXPO_PUBLIC_ANTHROPIC_API_KEY — the
# EXPO_PUBLIC_ prefix gets bundled into the client app, which would ship your
# key to anyone who installs the app. This key is only read by the server-side
# API routes in app/api/, which run on your machine / dev server, not on the phone.
ANTHROPIC_API_KEY=sk-ant-...
